# ---------------------------------------------------------------------------
# stallion_tally_azure configuration
#
# Copy this file to `.env` next to the application and edit the values.
# Never commit `.env`. Never put secrets in source code.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=production
# Directory for the local SQLite database, raw Tally responses, exports, logs.
# Relative paths are resolved against the working directory of the process.
APP_DATA_DIR=./data
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console
LOG_TO_FILE=true

# --- TallyPrime ------------------------------------------------------------
# TallyPrime must be configured to act as a server on this port
# (F1 Help > Settings > Connectivity > Client/Server configuration).
# The port must NOT be reachable from the internet.
TALLY_HOST=localhost
TALLY_PORT=9000
TALLY_TIMEOUT_SECONDS=300
TALLY_CONNECT_TIMEOUT_SECONDS=5

# Day Book extraction window. Vouchers are requested from Tally in
# TALLY_VOUCHER_CHUNK_DAYS slices and processed in TALLY_VOUCHER_CHUNK_SIZE batches.
TALLY_VOUCHER_LOOKBACK_DAYS=90
TALLY_VOUCHER_CHUNK_SIZE=500
TALLY_VOUCHER_CHUNK_DAYS=7

# Optional comma-separated allow-list of company names. Empty = all loaded companies.
TALLY_COMPANIES=

# Backoff used by the background agent while Tally is not running.
TALLY_UNAVAILABLE_BACKOFF_SECONDS=30
TALLY_UNAVAILABLE_MAX_BACKOFF_SECONDS=600

# --- Local persistence -----------------------------------------------------
# Defaults to sqlite:///<APP_DATA_DIR>/local.db
DATABASE_URL=
# Days to keep raw Tally XML responses and local export files.
RAW_RETENTION_DAYS=14
EXPORT_RETENTION_DAYS=14

# --- Synchronisation -------------------------------------------------------
SYNC_INTERVAL_SECONDS=300
# The background agent re-pulls the full voucher lookback window at most this often.
SYNC_FULL_REFRESH_INTERVAL_SECONDS=3600
# Between full refreshes only the last N days of vouchers are re-pulled.
SYNC_INCREMENTAL_DAYS=7
SYNC_DATASETS=companies,groups,ledgers,stock_items,bills,vouchers

# --- Retry policy ----------------------------------------------------------
RETRY_MAX_ATTEMPTS=5
RETRY_BACKOFF_SECONDS=2,5,15,30,60

# --- Azure export ----------------------------------------------------------
# azure    = upload to Azure Blob Storage
# local    = write the same layout to a local folder (for testing without Azure)
# disabled = sync to SQLite only
AZURE_STORAGE_BACKEND=azure

# Development / simple deployments: connection string of the storage account.
AZURE_STORAGE_CONNECTION_STRING=
# Production: leave the connection string empty and set the account URL.
# Authentication then uses Azure Managed Identity / DefaultAzureCredential.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=stallion-tally-data
AZURE_CREATE_CONTAINER=true
# Also upload the raw Tally XML responses under raw/{company}/{dataset}/{date}/
AZURE_UPLOAD_RAW=true
# Folder used when AZURE_STORAGE_BACKEND=local (defaults to <APP_DATA_DIR>/azure_local)
AZURE_LOCAL_BACKEND_DIR=

# --- Export ----------------------------------------------------------------
EXPORT_BATCH_SIZE=500
EXPORT_INCLUDE_RAW_JSON=true
